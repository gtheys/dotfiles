input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            variant "us,fr"
            options "grp:ctrl_shift_toggle"
        }
    }
}
